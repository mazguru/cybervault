# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Standalone Local Admin Login (optional; if omitted, first-run setup UI claims the admin password)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional comma-separated Google emails allowed when signing in with Google Drive (e.g. datacenter2@smkn1temon.sch.id)
ALLOWED_GOOGLE_EMAILS=

# Optional rclone remote name configured on the CyberPanel VPS (default: gdrive)
RCLONE_REMOTE=

# Google OAuth 2.0 Client ID for browser "Login dengan Google Drive"
VITE_GOOGLE_CLIENT_ID=
